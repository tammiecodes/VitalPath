<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VITAL PATH"
            android:textColor="#6CB7FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Health Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stay on top of your health, one day at a time."
            android:textColor="#B0BCCC"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"/>

        <include
            layout="@layout/view_medical_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Full-width featured action -->
        <Button
            android:id="@+id/btnHealthConnect"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="♥  CONNECT HEALTH DATA"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@null"
            android:background="@drawable/dashboard_button_bg"
            android:layout_marginTop="12dp"/>

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnDailyCheckIn"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:text="✎\nDaily Check-In"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:backgroundTint="@null"
                android:background="@drawable/dashboard_button_bg"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnCalendar"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:text="▦\nCalendar"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:backgroundTint="@null"
                android:background="@drawable/dashboard_button_bg"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnMedicationsPage"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:text="✚\nMedications"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:backgroundTint="@null"
                android:background="@drawable/dashboard_button_bg"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnHealthSummary"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:text="▥\nHealth Summary"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:backgroundTint="@null"
                android:background="@drawable/dashboard_button_bg"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnDoctorReport"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:text="▤\nDoctor Visit Report"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:backgroundTint="@null"
                android:background="@drawable/dashboard_button_bg"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:text="⚙\nProfile &amp; Settings"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:backgroundTint="@null"
                android:background="@drawable/dashboard_button_bg"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
