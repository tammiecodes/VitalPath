<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="60dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log in to continue tracking your health."
            android:textSize="16sp"
            android:textColor="#B0BCCC"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/etLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BCCC"/>

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0BCCC"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnSubmitLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log In"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"
            android:layout_marginTop="36dp"/>

        <Button
            android:id="@+id/btnBackToWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
