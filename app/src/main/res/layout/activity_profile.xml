<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101827"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile &amp; Settings"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your health profile and preferences."
            android:textColor="#B0BCCC"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Not set\nEmail: Not set"
            android:textColor="#B0BCCC"
            android:textSize="16sp"
            android:padding="20dp"
            android:background="#1B2A40"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health Settings"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"/>

        <Button
            android:id="@+id/btnEditConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Chronic Conditions"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"/>

        <Button
            android:id="@+id/btnEditSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Tracked Symptoms"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"/>

        <Button
            android:id="@+id/btnEditPreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tracking Preferences"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"/>

        <Button
            android:id="@+id/btnBackProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"
            android:layout_marginTop="32dp"/>

    </LinearLayout>
</ScrollView>
