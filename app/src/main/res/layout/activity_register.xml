<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#101827">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Create Your Account" android:textSize="28sp"
            android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="40dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Start your health tracking journey (demo only)."
            android:textSize="16sp" android:textColor="#B0BCCC"
            android:layout_marginTop="12dp" android:layout_marginBottom="28dp" />
        <EditText android:id="@+id/etName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Full Name"
            android:inputType="textPersonName" android:autofillHints="name"
            android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#B0BCCC" />
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Email Address"
            android:inputType="textEmailAddress" android:autofillHints="emailAddress"
            android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#B0BCCC"
            android:layout_marginTop="20dp" />
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Password (not used in demo)"
            android:inputType="textPassword" android:autofillHints="newPassword"
            android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#B0BCCC"
            android:layout_marginTop="20dp" />
        <Button android:id="@+id/btnReadPrivacy" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Read Privacy &amp; Health Data Notice"
            android:textColor="#FFFFFF" android:backgroundTint="#34465C"
            android:layout_marginTop="24dp" />
        <CheckBox android:id="@+id/cbPrivacyAck" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:buttonTint="#3078E8"
            android:text="I have read the prototype privacy notice and understand this is not a secure patient portal."
            android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnContinue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Create Account"
            android:textColor="#FFFFFF" android:backgroundTint="#3078E8"
            android:layout_marginTop="22dp" />
        <Button android:id="@+id/btnBack" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Back"
            android:textColor="#FFFFFF" android:backgroundTint="#34465C" />
    </LinearLayout>
</ScrollView>
