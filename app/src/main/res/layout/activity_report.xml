<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101827" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Doctor Visit Report" android:textSize="28sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:layout_marginTop="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Create a private PDF of your patient-entered records."
            android:textColor="#B0BCCC" android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />
        <Button android:id="@+id/btnReportStartDate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Select Start Date"
            android:backgroundTint="#34465C" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnReportEndDate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Select End Date"
            android:backgroundTint="#34465C" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/txtReportPreview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="20dp"
            android:background="#1B2A40" android:textColor="#FFFFFF" android:textSize="16sp"
            android:layout_marginTop="24dp" />
        <Button android:id="@+id/btnGeneratePDF" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Generate &amp; Save PDF"
            android:backgroundTint="#3078E8" android:textColor="#FFFFFF"
            android:layout_marginTop="20dp" />
        <Button android:id="@+id/btnBackReport" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Back"
            android:backgroundTint="#34465C" android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
