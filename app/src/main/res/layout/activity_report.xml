<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101827"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doctor Visit Report"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prepare a summary to share at your next appointment."
            android:textColor="#B0BCCC"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Date Range"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnReportStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Start Date"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnReportEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select End Date"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Preview"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="#1B2A40"
            android:text="VITAL PATH - PATIENT REPORT\n\nPatient: Not available\n\nChronic Conditions:\nNo information available\n\nSymptoms:\nNo entries available\n\nVital Signs:\nNo entries available\n\nMedications:\nNo medications available\n\nThis report is for personal health recordkeeping."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnGeneratePDF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate PDF"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"
            android:layout_marginTop="32dp"/>

        <Button
            android:id="@+id/btnBackReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"/>

    </LinearLayout>
</ScrollView>
