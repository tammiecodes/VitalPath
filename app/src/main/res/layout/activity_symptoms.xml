<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 2 of 3"
            android:textColor="#6CB7FF"
            android:textSize="14sp"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Your Symptoms"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select the symptoms you'd like to monitor."
            android:textColor="#B0BCCC"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"/>

        <CheckBox
            android:id="@+id/cbFatigue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fatigue"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <CheckBox
            android:id="@+id/cbHeadache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Headache"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <CheckBox
            android:id="@+id/cbDizziness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dizziness"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <CheckBox
            android:id="@+id/cbShortnessOfBreath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shortness of Breath"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <CheckBox
            android:id="@+id/cbNausea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nausea"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <CheckBox
            android:id="@+id/cbChestPain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chest Pain"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <CheckBox
            android:id="@+id/cbOtherSymptom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Other"
            android:textColor="#FFFFFF"
            android:buttonTint="#3078E8"/>

        <Button
            android:id="@+id/btnNextSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3078E8"
            android:layout_marginTop="36dp"/>

        <Button
            android:id="@+id/btnBackSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34465C"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
